{
  "name": "aws-elastic-beanstalk-express-js-sample",
  "version": "1.0.0",
  "description": "Sample Node.js (Express) app for AWS Elastic Beanstalk",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "mocha \"test/**/*.test.js\" --timeout 5000 --fail-zero",
    "test:ci": "mocha \"test/**/*.test.js\" --timeout 5000 --fail-zero --reporter mocha-junit-reporter --reporter-options mochaFile=reports/junit.xml",
    "audit:ci": "npm audit --audit-level=high"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aws-samples/aws-elastic-beanstalk-express-js-sample.git"
  },
  "license": "MIT-0",
  "dependencies": {
    "express": "^4.22.2"
  },
  "devDependencies": {
    "mocha": "10.8.2",
    "mocha-junit-reporter": "2.2.1",
    "supertest": "7.3.0"
  }
}
